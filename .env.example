# Agent Farm environment example. Copy to .env and edit local values as needed.

# Frontend dev server
# Bind host for the Next dev server. Use 0.0.0.0 to listen on all interfaces;
# browse to https://localhost on this machine, or to this machine's hostname/LAN
# IP from another device. The frontend dev server uses HTTPS.
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
# Extra comma-separated hostnames allowed to load Next dev assets.
# FRONTEND_ALLOWED_DEV_ORIGINS=farm22-wrstat01.internal.example.org
# Usually set by run-dev.sh from AGENTFARM_TLS_CERT/AGENTFARM_TLS_KEY.
# FRONTEND_TLS_CERT=data/tls/agentfarm-self-signed.crt
# FRONTEND_TLS_KEY=data/tls/agentfarm-self-signed.key

# Backend launcher / frontend BFF
BACKEND_PORT=8000
# Frontend server-side backend URL. Defaults to https://127.0.0.1:${BACKEND_PORT}.
# BACKEND_URL=https://127.0.0.1:8000
# Set to 0 for one-process backend startup, useful in CI/e2e.
UVICORN_RELOAD=1

# Backend storage
AGENTFARM_DATA_DIR=data
# SQLite online backups are disabled when this is unset or blank.
# AGENTFARM_BACKUP_DIR=data/backups
# Background backup cadence, in seconds. Dirty writes are backed up at most once
# per interval.
AGENTFARM_BACKUP_INTERVAL_SECONDS=600

# Authentication / authorisation
# AGENTFARM_OWNER defaults to the OS user running the backend.
# AGENTFARM_OWNER=alice
# Comma-separated viewer usernames.
# AGENTFARM_WHITELIST=bob,carol
# LDAP direct-bind login settings.
# AGENTFARM_LDAP_SERVER=ldaps://ldap.example.com
# AGENTFARM_LDAP_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com

# Backend TLS
# Set both to use an existing certificate/key pair. Leave both unset to let the
# backend generate a local self-signed pair under AGENTFARM_DATA_DIR/tls/.
# AGENTFARM_TLS_CERT=/path/to/cert.pem
# AGENTFARM_TLS_KEY=/path/to/key.pem

# Script/runtime overrides
# Next.js telemetry opt-out for local or automated runs.
# NEXT_TELEMETRY_DISABLED=1
# Python executable used by backend/run_uvicorn.sh and run-dev.sh helpers.
# PYTHON=backend/.venv/bin/python
# Browser executable override used by Playwright discovery.
# AGENTFARM_PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/path/to/chrome
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/path/to/chrome
# CHROME_PATH=/path/to/chrome
# CHROME_BIN=/path/to/chrome
# CHROMIUM_PATH=/path/to/chromium
# CHROMIUM_BIN=/path/to/chromium
# GOOGLE_CHROME_BIN=/path/to/google-chrome
# PUPPETEER_EXECUTABLE_PATH=/path/to/chrome
# PLAYWRIGHT_BROWSERS_PATH=/path/to/playwright/browser/cache

# Playwright e2e overrides. These default to isolated ports and data dirs under
# .tmp/agent/playwright/ and usually do not need to be set for local use.
# PLAYWRIGHT_RUN_ID=local
# PLAYWRIGHT_FRONTEND_PORT=3100
# PLAYWRIGHT_BACKEND_PORT=8100
# PLAYWRIGHT_FRONTEND_URL=https://127.0.0.1:3100
# PLAYWRIGHT_BACKEND_URL=https://127.0.0.1:8100
# PLAYWRIGHT_AGENTFARM_DATA_DIR=.tmp/agent/playwright/local/data
# PLAYWRIGHT_FAKE_LDAP_PORT=8390
# PLAYWRIGHT_FAKE_LDAP_HEALTH_PORT=8391
