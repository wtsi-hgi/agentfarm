# Frontend configuration
FRONTEND_PORT=3000

# Backend configuration
BACKEND_PORT=8000

# Backend URL (optional - defaults to https://127.0.0.1:${BACKEND_PORT})
# BACKEND_URL=https://127.0.0.1:8000

# CORS origins (comma-separated, defaults to "*" for development)
# CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
