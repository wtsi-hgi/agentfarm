# Frontend configuration
# Bind host for the Next dev server. Use 0.0.0.0 to listen on all interfaces;
# browse to https://localhost on this machine, or to this machine's hostname/LAN
# IP from another device. The frontend dev server uses HTTPS.
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# Backend configuration
BACKEND_PORT=8000

# Backend URL (optional - defaults to https://127.0.0.1:${BACKEND_PORT})
# BACKEND_URL=https://127.0.0.1:8000

# CORS origins (comma-separated, defaults to "*" for development)
# CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
