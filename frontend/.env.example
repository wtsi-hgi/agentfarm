# Frontend Environment Variables
# Copy this file to .env.local and adjust values as needed

# Backend connection (used by API routes). The local backend serves HTTPS.
BACKEND_URL=https://127.0.0.1:8000
# Or just set the port:
# BACKEND_PORT=8000

# Frontend server bind host and port. The frontend dev server uses HTTPS.
# 0.0.0.0 listens on all interfaces but is not the browser URL; use
# https://localhost on this machine, or this machine's hostname/LAN IP from
# another device.
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
